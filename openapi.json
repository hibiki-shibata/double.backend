    "/api/v1/wallet/history": {
      "get": {
        "summary": "Get wallet transaction history",
        "tags": [
          "Wallet"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 1
            },
            "required": false,
